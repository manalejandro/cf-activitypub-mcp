/**
 * CF ActivityPub MCP — Wrangler configuration.
 *
 * For more details refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets (never stored in this file):
 *   npx wrangler secret put ADMIN_TOKEN      # operator token of the CF ActivityPub instance
 *   npx wrangler secret put MCP_AUTH_TOKEN   # bearer token required by /mcp and /sse
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cf-activitypub-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-04",
	"compatibility_flags": ["nodejs_compat"],

	/**
	 * Observability: traces, logs and real-time issues for the worker.
	 * https://developers.cloudflare.com/workers/observability/
	 */
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true
		},
		"issues": {
			"enabled": true
		}
	},
	"upload_source_maps": true,

	/**
	 * Custom domain: replace `mcp.example.com` with your own subdomain.
	 * Wrangler creates/attaches the DNS record and certificate on deploy.
	 * https://developers.cloudflare.com/workers/configuration/routing/custom-domains/
	 */
	"routes": [
		{
			"pattern": "mcp.example.com",
			"custom_domain": true
		}
	],

	/**
	 * Plain-text variables. Update `ACTIVITYPUB_URL` to the public URL of your
	 * CF ActivityPub instance before deploying.
	 */
	"vars": {
		"ACTIVITYPUB_URL": "https://social.example.com",
		"MCP_SERVER_NAME": "cf-activitypub-mcp",
		"MCP_SERVER_VERSION": "1.0.0"
		/**
		 * Optional hardening: comma-separated Host allowlist for the MCP
		 * endpoints (custom domains). Localhost and workers.dev are always
		 * accepted when this is unset.
		 */
		// "MCP_ALLOWED_HOSTNAMES": "mcp.example.com",
		/**
		 * Optional: comma-separated browser Origin allowlist, or `*` when an
		 * upstream layer validates origins. Needed only for browser clients.
		 */
		// "MCP_ALLOWED_ORIGINS": "https://app.example.com"
	}
}
